{
  "name": "voteai-video",
  "version": "1.0.0",
  "description": "Vídeos do voteAI feitos com Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "node scripts/sync-assets.mjs && remotion studio",
    "render": "node scripts/sync-assets.mjs && remotion render LandingVideo ../src/assets/media/voteai-explainer.mp4 --codec=h264 --crf=23",
    "poster": "node scripts/sync-assets.mjs && remotion still LandingVideo ../public/assets/voteai-explainer-poster.png --frame=62",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
